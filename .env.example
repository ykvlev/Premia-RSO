# Шаблон переменных окружения «Труд крут». Скопируй в .env и заполни.
# .env НЕ коммитить (в .gitignore). Этот файл — коммитится.

# ── База данных (PostgreSQL, на проде — РФ-хостинг) ──────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/trud_krut?schema=public"

# ── NextAuth (v5 читает AUTH_SECRET) ─────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="сгенерировать: openssl rand -base64 32"

# ── S3-совместимое хранилище РФ (Yandex Object Storage / VK Cloud) ───────
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── SMTP для писем-подтверждений ─────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="nomination@trudkrut.ru"

# ── Yandex SmartCaptcha (заглушка, если пусто) ───────────────────────────
SMARTCAPTCHA_SERVER_KEY=""
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=""

# ── Telegram-уведомления оргкомитету (пусто → выключено) ────────────────
# Создать бота у @BotFather, добавить в чат, взять chat_id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
