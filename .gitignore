# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# вложения заявок при локальном dev-драйвере хранилища
/.uploads

# prisma agent-skill scaffolding (не используется в этом проекте)
/.windsurf
/.agents
/skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Локальные креды/секреты (не коммитить)
.created-users.local.txt
prisma/.created-users.local.txt
prisma/.users.local.json
.env.production

# dev logs
dev*.log

# claude local settings
.claude/

# SSH key
*.pem.pub
